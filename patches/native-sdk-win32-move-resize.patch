+/* Move by a screen-space delta (dx right, dy DOWN, the pointer
+ * convention), optionally clamped to the owning monitor's work area,
+ * and report the applied origin, clamp stops, the live primary-button
+ * state, and the global cursor — the same contract
+ * native_sdk_appkit_move_window implements on macOS, which the runtime
+ * surfaces as MoveWindowResult for app-driven drag physics. Origins and
+ * the cursor are LOGICAL points: the physical GetWindowRect/GetCursorPos
+ * values divide by the window's own DPI scale, and a DPI-unaware
+ * process (scale 1) passes them through unchanged. Physical work-area
+ * bounds clamp the physical target and the clamped origin converts
+ * back, so mixed-DPI boundaries clamp where the window actually is. */
+int native_sdk_windows_move_window(Host *host, uint64_t window_id, double dx, double dy, int clamp, double *out_x, double *out_y, int *out_hit_x, int *out_hit_y, int *out_primary_down, double *out_vx, double *out_vy, int *out_released, double *out_cursor_x, double *out_cursor_y) {
+    if (out_hit_x) *out_hit_x = 0;
+    if (out_hit_y) *out_hit_y = 0;
+    if (out_vx) *out_vx = 0;
+    if (out_vy) *out_vy = 0;
+    if (out_released) *out_released = 0;
+    if (!host) return 0;
+    auto found = host->windows.find(window_id);
+    if (found == host->windows.end() || !found->second.hwnd) return 0;
+    HWND hwnd = found->second.hwnd;
+    RECT rect = {};
+    if (!GetWindowRect(hwnd, &rect)) return 0;
+    const double scale = gpuSurfaceScale(hwnd);
+    if (scale <= 0) return 0;
+    double phys_x = (double)rect.left + dx * scale;
+    double phys_y = (double)rect.top + dy * scale;
+    if (clamp) {
+        HMONITOR monitor = MonitorFromWindow(hwnd, MONITOR_DEFAULTTONEAREST);
+        MONITORINFO info = {};
+        info.cbSize = sizeof(info);
+        if (monitor && GetMonitorInfoW(monitor, &info)) {
+            const RECT &work = info.rcWork;
+            if (phys_x < (double)work.left) { phys_x = work.left; if (out_hit_x) *out_hit_x = 1; }
+            if (phys_x > (double)work.right - (rect.right - rect.left)) { phys_x = (double)work.right - (rect.right - rect.left); if (out_hit_x) *out_hit_x = 1; }
+            if (phys_y < (double)work.top) { phys_y = work.top; if (out_hit_y) *out_hit_y = 1; }
+            if (phys_y > (double)work.bottom - (rect.bottom - rect.top)) { phys_y = (double)work.bottom - (rect.bottom - rect.top); if (out_hit_y) *out_hit_y = 1; }
+        }
+    }
+    if (dx != 0 || dy != 0) {
+        SetWindowPos(hwnd, nullptr, (int)llround(phys_x), (int)llround(phys_y), 0, 0, SWP_NOSIZE | SWP_NOZORDER | SWP_NOACTIVATE);
+    }
+    if (out_x) *out_x = phys_x / scale;
+    if (out_y) *out_y = phys_y / scale;
+    /* Live physical button state, NOT GetKeyState: that reads the
+     * calling thread's message-queue snapshot, and the runtime's loop
+     * thread is not the message pump, so mid-drag polls saw stale
+     * "released" values that aborted app-owned drags (spurious
+     * momentum throws). GetAsyncKeyState is thread-independent. */
+    if (out_primary_down) *out_primary_down = (GetAsyncKeyState(VK_LBUTTON) & 0x8000) ? 1 : 0;
+    if (out_cursor_x || out_cursor_y) {
+        POINT cursor = {};
+        GetCursorPos(&cursor);
+        if (out_cursor_x) *out_cursor_x = (double)cursor.x / scale;
+        if (out_cursor_y) *out_cursor_y = (double)cursor.y / scale;
+    }
+    return 1;
+}
+
+/* Resize to an exact logical size keeping an anchor fixed
+ * (`.bottom_center` grows in place; `.top_left` is the default), the
+ * companion-window fit verb. Physical SetWindowPos sizes scale up the
+ * logical request; the kept anchor edge converts the same way move
+ * does, so a bottom_center resize on a scaled monitor keeps the
+ * sprite's feet planted. */
+int native_sdk_windows_resize_window(Host *host, uint64_t window_id, double width, double height, int anchor_bottom_center) {
+    if (!host || width <= 0 || height <= 0) return 0;
+    auto found = host->windows.find(window_id);
+    if (found == host->windows.end() || !found->second.hwnd) return 0;
+    HWND hwnd = found->second.hwnd;
+    RECT rect = {};
+    if (!GetWindowRect(hwnd, &rect)) return 0;
+    const double scale = gpuSurfaceScale(hwnd);
+    if (scale <= 0) return 0;
+    const double phys_w = width * scale;
+    const double phys_h = height * scale;
+    /* The client area is what the runtime sizes; keep the existing
+     * chrome margins so the logical request maps to client points. */
+    RECT client = {};
+    GetClientRect(hwnd, &client);
+    const double chrome_x = (rect.right - rect.left) - (client.right - client.left);
+    const double chrome_y = (rect.bottom - rect.top) - (client.bottom - client.top);
+    double phys_x = (double)rect.left;
+    double phys_y = (double)rect.top;
+    if (anchor_bottom_center) {
+        phys_x = (double)rect.left + ((rect.right - rect.left) - phys_w - chrome_x) / 2.0;
+        phys_y = (double)rect.bottom - phys_h - chrome_y;
+    }
+    SetWindowPos(hwnd, nullptr, (int)llround(phys_x), (int)llround(phys_y), (int)llround(phys_w + chrome_x), (int)llround(phys_h + chrome_y), SWP_NOZORDER | SWP_NOACTIVATE);
+    return 1;
+}
