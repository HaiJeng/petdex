+/// Move by a screen-space delta and report the applied origin, clamp
+/// stops, primary-button state, and the global cursor — the drag
+/// physics seam macOS implements the same way. The host reports LOGICAL
+/// points, matching the runtime's window-geometry convention.
+fn moveWindow(context: ?*anyopaque, window_id: platform_mod.WindowId, dx: f64, dy: f64, clamp: bool) anyerror!platform_mod.MoveWindowResult {
+    const self: *WindowsPlatform = @ptrCast(@alignCast(context.?));
+    var out_x: f64 = 0;
+    var out_y: f64 = 0;
+    var out_hit_x: c_int = 0;
+    var out_hit_y: c_int = 0;
+    var out_primary: c_int = 0;
+    var out_vx: f64 = 0;
+    var out_vy: f64 = 0;
+    var out_released: c_int = 0;
+    var out_cursor_x: f64 = 0;
+    var out_cursor_y: f64 = 0;
+    if (native_sdk_windows_move_window(self.host, window_id, dx, dy, if (clamp) 1 else 0, &out_x, &out_y, &out_hit_x, &out_hit_y, &out_primary, &out_vx, &out_vy, &out_released, &out_cursor_x, &out_cursor_y) == 0) return error.WindowNotFound;
+    return .{ .x = out_x, .y = out_y, .hit_x = out_hit_x != 0, .hit_y = out_hit_y != 0, .primary_down = out_primary != 0, .vx = out_vx, .vy = out_vy, .released = out_released != 0, .cursor_x = out_cursor_x, .cursor_y = out_cursor_y };
+}
+
+/// Resize to an exact logical size, anchored `.top_left` or
+/// `.bottom_center` (the companion-window fit verb).
+fn resizeWindow(context: ?*anyopaque, window_id: platform_mod.WindowId, width: f64, height: f64, anchor: platform_mod.WindowResizeAnchor) anyerror!void {
+    const self: *WindowsPlatform = @ptrCast(@alignCast(context.?));
+    if (native_sdk_windows_resize_window(self.host, window_id, width, height, if (anchor == .bottom_center) 1 else 0) == 0) return error.WindowNotFound;
+}
+
 fn startWindowDrag(context: ?*anyopaque, window_id: platform_mod.WindowId) anyerror!void {
     const self: *WindowsPlatform = @ptrCast(@alignCast(context.?));
     if (native_sdk_windows_start_window_drag(self.host, window_id) == 0) return error.WindowNotFound;
