+ * sprite's feet planted. */
+int native_sdk_windows_resize_window(Host *host, uint64_t window_id, double width, double height, int anchor_bottom_center) {
+    if (!host || width <= 0 || height <= 0) return 0;
+    auto found = host->windows.find(window_id);
+    if (found == host->windows.end() || !found->second.hwnd) return 0;
+    HWND hwnd = found->second.hwnd;
+    RECT rect = {};
+    if (!GetWindowRect(hwnd, &rect)) return 0;
+    const double scale = gpuSurfaceScale(hwnd);
+    if (scale <= 0) return 0;
+    const double phys_w = width * scale;
+    const double phys_h = height * scale;
+    /* The client area is what the runtime sizes; keep the existing
+     * chrome margins so the logical request maps to client points. */
+    RECT client = {};
+    GetClientRect(hwnd, &client);
+    const double chrome_x = (rect.right - rect.left) - (client.right - client.left);
+    const double chrome_y = (rect.bottom - rect.top) - (client.bottom - client.top);
